  "project": {
    "description": "the pnp Claude Code plugin - a disciplined four-role working loop with native operator gates; this repository is the plugin itself, self-installed so its own development runs under the loop it ships",
    "stack": "Node.js (zero dependencies), PowerShell + bash wrappers, Claude Code plugin (skills, hooks, agents, templates, migrations)",
    "root": "auto",
    "defaultBranch": "main",
    "name": "PromptAndPray"
  },
  "os": "windows",
  "operator": {
    "language": "bg",
    "roleNicknames": {
      "writer": "Колега",
      "reviewer": "Одитор",
      "qa": "QA"
    }
  },
  "roles": {
    "reviewer": {
      "engine": "codex",
      "model": "gpt-5.6-sol",
      "effort": "high"
    },
    "qa": {
      "engine": "codex",
      "model": "gpt-5.6-sol",
      "effort": "high"
    },
    "qal": {
      "enabled": false,
      "engine": "codex",
      "model": "gpt-5.6-sol",
      "effort": "high"
    },
    "writer": {
      "model": "claude-opus-5-5[1m]",
      "effort": "high"
    }
  },
  "loop": {
    "correctionRoundsCap": 2
  },
  "enforcement": {
    "dispatchGate": "off-plan",
    "routeWriteGuard": true
  },
  "verify": {
    "commands": [
      {
        "name": "validate-payload",
        "run": "node scripts/update/validate-payload.mjs --plugin-root .",
        "cwd": "."
      },
      {
        "name": "setup-suite",
        "run": "node scripts/setup/test-setup.mjs",
        "cwd": "."
      },
      {
        "name": "update-suite",
        "run": "node scripts/update/test-update.mjs",
        "cwd": "."
      },
      {
        "name": "example-cycle-windows",
        "run": "node scripts/ci/run-example-cycle.mjs",
        "cwd": "."
      },
      {
        "name": "example-cycle-linux",
        "run": "node scripts/ci/run-example-cycle.mjs --answers examples/example-project/answers-linux.json",
        "cwd": "."
      },
      {
        "name": "selfcheck",
        "run": "node scripts/selfcheck/aiwf-selfcheck.js --plugin-root . --project-fixture .",
        "cwd": "."
      },
      {
        "name": "spikes",
        "run": "node scripts/spike/run-spikes.mjs",
        "cwd": "."
      },
      {
        "name": "plugin-validate",
        "run": "claude plugin validate .",
        "cwd": "."
      }
    ],
    "e2e": {
      "enabled": false,
      "cwd": ".",
      "runner": "npx playwright test",
      "specDir": "e2e",
      "outputDir": "test-results/aiwf-qa"
    }
  },
  "paths": {
    "scratchDir": ".aiwf",
    "plansDir": "dev/backlogs",
    "overridesDoc": "dev/PROJECT_OVERRIDES.md",
    "transferSurface": "dev/backlogs/CANDIDATES.md"
  },
  "review": {
    "productBoundaryChecks": [
      "Payload stays generic: no origin-project names, no Cyrillic, no absolute paths (the provenance section of the self-check is the gate)",
      "A managed-artifact change ships as a migration + version bump, never silently",
      "Every operator gate that can be a native dialog is a native dialog"
    ],
    "plan": {
      "passes": 2,
      "engine": "codex",
      "model": "gpt-6-sol",
      "effort": "xhigh"
    },
    "code": {
      "passes": 1,
      "engine": "codex",
      "model": "gpt-6-sol",
      "effort": "xhigh"
    },
    "docs": {
      "passes": 0
    }
  }
}
